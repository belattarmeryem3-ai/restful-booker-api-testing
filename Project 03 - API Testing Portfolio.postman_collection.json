      "name": "03 - Get Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Firstname is correct\", function () {\r",
              "    pm.expect(response.firstname).to.eql(\"Meryem\");\r",
              "});\r",
              "\r",
              "pm.test(\"Lastname is correct\", function () {\r",
              "    pm.expect(response.lastname).to.eql(\"QA\");\r",
              "});\r",
              "\r",
              "pm.test(\"Total price is correct\", function () {\r",
              "    pm.expect(response.totalprice).to.eql(500);\r",
              "});\r",
              "\r",
              "pm.test(\"Deposit is paid\", function () {\r",
              "    pm.expect(response.depositpaid).to.eql(true);\r",
              "});\r",
              "\r",
              "pm.test(\"Check-in date is correct\", function () {\r",
              "    pm.expect(response.bookingdates.checkin).to.eql(\"2026-09-01\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check-out date is correct\", function () {\r",
              "    pm.expect(response.bookingdates.checkout).to.eql(\"2026-09-05\");\r",
              "});\r",
              "\r",
              "pm.test(\"Additional needs is correct\", function () {\r",
              "    pm.expect(response.additionalneeds).to.eql(\"Breakfast\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
